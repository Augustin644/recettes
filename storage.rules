rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos de recettes : .../photos/{uid}/{fileId}
    match /photos/{uid}/{fileId} {
      allow read, write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024   // max 8 Mo par photo
        && request.resource.contentType.matches('image/.*');
    }

    // Avatars : .../avatars/{uid}
    match /avatars/{avatarId} {
      allow read, write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}